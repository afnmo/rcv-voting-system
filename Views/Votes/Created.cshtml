@model VotingSystem.ViewModels.VoteCreatedViewModel

<div class="max-w-3xl mx-auto px-6 py-14">
    <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm text-center">

        <div class="text-5xl mb-3">
            <i class="fa-solid fa-circle-check text-green-500"></i>
        </div>

        <h1 class="text-2xl font-extrabold text-gray-900">
            تم إنشاء التصويت بنجاح
        </h1>

        <p class="mt-2 text-gray-600">
            شارك الرابط
        </p>

        <div class="mt-6 text-start">
            <label class="text-xs font-semibold text-gray-600 flex items-center gap-2">
                <i class="fa-solid fa-link text-gray-400"></i>
                رابط المشاركة
            </label>

            <div class="mt-2 flex gap-2">
                <input id="shareLink"
                       readonly
                       value="@Model.ShareUrl"
                       class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-gray-50" />

                <button type="button"
                        onclick="navigator.clipboard.writeText(document.getElementById('shareLink').value)"
                        class="px-5 rounded-xl bg-purple-600 text-white text-sm font-medium hover:bg-purple-700">
                    <i class="fa-solid fa-copy me-1"></i>
                    نسخ
                </button>
            </div>
        </div>

        <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
            <a href="@Model.ShareUrl"
               class="px-6 py-3 rounded-xl bg-purple-600 text-white text-sm font-medium hover:bg-purple-700">
                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
                فتح التصويت
            </a>

            <a asp-action="Details" asp-route-id="@Model.VoteId"
               class="px-6 py-3 rounded-xl border border-gray-200 text-gray-700 text-sm font-medium hover:bg-gray-50">
                <i class="fa-solid fa-gear me-1"></i>
                إدارة التصويت
            </a>
        </div>

    </div>
</div>
