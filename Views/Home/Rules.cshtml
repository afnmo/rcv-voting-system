@{
    ViewData["Title"] = "القوانين";
}

<section class="bg-gradient-to-b from-purple-50 via-white to-white">
    <div class="max-w-6xl mx-auto px-6 py-14">

        <div class="text-center">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-purple-100 shadow-sm">
                <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
                <span class="text-xs font-semibold text-purple-700">VOTISE • Ranked Choice Voting</span>
            </div>

            <h1 class="mt-6 text-3xl md:text-5xl font-black text-gray-900 leading-tight">
                قوانين التصويت بالترتيب
                <span class="text-transparent bg-clip-text bg-gradient-to-l from-purple-600 to-fuchsia-600">
                    (RCV)
                </span>
            </h1>

            <p class="mt-4 text-gray-600 text-base md:text-lg max-w-3xl mx-auto leading-relaxed">
                بدل ما تختار خيار واحد… هنا ترتّب الخيارات حسب الأفضل لك.
                النظام يسوي جولات تلقائيًا ويطلع الفائز بطريقة عادلة تعتمد على تفضيلات الأغلبية.
            </p>

            <div class="mt-7 flex justify-center gap-3 flex-wrap">
                <a href="#how"
                   class="px-6 py-3 rounded-xl bg-purple-600 text-white text-sm font-semibold hover:bg-purple-700 transition shadow-sm">
                    <i class="fa-solid fa-book-open me-1"></i>
                    كيف يصير التصويت؟
                </a>
                <a href="#example"
                   class="px-6 py-3 rounded-xl bg-white border border-gray-200 text-gray-800 text-sm font-semibold hover:bg-gray-50 transition">
                    <i class="fa-solid fa-diagram-project me-1 text-purple-600"></i>
                    مثال سريع
                </a>
                <a href="#faq"
                   class="px-6 py-3 rounded-xl bg-white border border-gray-200 text-gray-800 text-sm font-semibold hover:bg-gray-50 transition">
                    <i class="fa-solid fa-circle-question me-1 text-purple-600"></i>
                    أسئلة شائعة
                </a>
            </div>
        </div>

        <div class="mt-12 h-px bg-gradient-to-l from-transparent via-purple-200 to-transparent"></div>

        <div id="how" class="mt-12 grid md:grid-cols-2 gap-6 items-start">

            <div class="bg-white rounded-3xl border border-purple-100 shadow-sm p-7">
                <h2 class="text-xl md:text-2xl font-extrabold text-gray-900 flex items-center gap-2">
                    <i class="fa-solid fa-list-ol text-purple-600"></i>
                    القاعدة الأساسية
                </h2>

                <p class="mt-3 text-gray-600 leading-relaxed">
                    التصويت هنا مو “اختر خيار واحد”.
                    أنت ترتّب الخيارات:
                </p>

                <div class="mt-5 grid gap-3">
                    <div class="flex items-center justify-between p-4 rounded-2xl bg-purple-50 border border-purple-100">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-xl bg-purple-600 text-white flex items-center justify-center font-black">1</span>
                            <span class="font-semibold text-gray-800">اختيارك الأول</span>
                        </div>
                        <span class="text-xs text-purple-700 font-semibold">الأفضل لك</span>
                    </div>

                    <div class="flex items-center justify-between p-4 rounded-2xl bg-gray-50 border border-gray-100">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-xl bg-gray-800 text-white flex items-center justify-center font-black">2</span>
                            <span class="font-semibold text-gray-800">اختيارك الثاني</span>
                        </div>
                        <span class="text-xs text-gray-600 font-semibold">خيار احتياطي</span>
                    </div>

                    <div class="flex items-center justify-between p-4 rounded-2xl bg-gray-50 border border-gray-100">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-xl bg-gray-800 text-white flex items-center justify-center font-black">3</span>
                            <span class="font-semibold text-gray-800">اختيارك الثالث</span>
                        </div>
                        <span class="text-xs text-gray-600 font-semibold">كذا تاخذ راحتك</span>
                    </div>
                </div>

                <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4">
                    <div class="font-extrabold text-amber-900 flex items-center gap-2">
                        <i class="fa-solid fa-lightbulb"></i>
                        تقدر ترتّب خيار واحد فقط… أو أكثر
                    </div>
                    <p class="mt-1 text-sm text-amber-800 leading-relaxed">
                        ترتيب أكثر = فرصتك أفضل إن صوتك ينتقل لخيار ثاني إذا انحذف خيارك الأول.
                    </p>
                </div>
            </div>

            <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-7">
                <h2 class="text-xl md:text-2xl font-extrabold text-gray-900 flex items-center gap-2">
                    <i class="fa-solid fa-gears text-purple-600"></i>
                    كيف يتم الحساب؟
                </h2>

                <div class="mt-6 space-y-4">

                    <div class="flex gap-4 p-4 rounded-2xl bg-gray-50 border border-gray-100">
                        <div class="w-10 h-10 rounded-xl bg-purple-600 text-white flex items-center justify-center font-black">
                            ①
                        </div>
                        <div>
                            <div class="font-extrabold text-gray-900">الجولة الأولى</div>
                            <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                                النظام يحسب فقط الاختيار رقم 1 من كل شخص.
                                إذا خيار جاب أكثر من 50% → يفوز مباشرة.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 p-4 rounded-2xl bg-gray-50 border border-gray-100">
                        <div class="w-10 h-10 rounded-xl bg-purple-600 text-white flex items-center justify-center font-black">
                            ②
                        </div>
                        <div>
                            <div class="font-extrabold text-gray-900">حذف الأقل</div>
                            <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                                إذا ما أحد وصل 50%… أقل خيار أصوات يتم حذفه من الجولة.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 p-4 rounded-2xl bg-gray-50 border border-gray-100">
                        <div class="w-10 h-10 rounded-xl bg-purple-600 text-white flex items-center justify-center font-black">
                            ③
                        </div>
                        <div>
                            <div class="font-extrabold text-gray-900">نقل الأصوات تلقائيًا</div>
                            <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                                أي شخص كان اختياره الأول هو الخيار المحذوف…
                                صوته ينتقل تلقائيًا للاختيار التالي في ترتيبه.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 p-4 rounded-2xl bg-gray-50 border border-gray-100">
                        <div class="w-10 h-10 rounded-xl bg-purple-600 text-white flex items-center justify-center font-black">
                            ④
                        </div>
                        <div>
                            <div class="font-extrabold text-gray-900">تكرار الجولات</div>
                            <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                                تتكرر العملية (حساب → حذف → نقل) حتى يطلع فائز.
                            </p>
                        </div>
                    </div>

                </div>

                <div class="mt-6 rounded-2xl border border-purple-200 bg-purple-50 px-5 py-4">
                    <div class="font-extrabold text-purple-900 flex items-center gap-2">
                        <i class="fa-solid fa-circle-check"></i>
                        الفكرة باختصار:
                    </div>
                    <p class="mt-1 text-sm text-purple-800 leading-relaxed">
                        بدل “تصويت واحد”، كأنك داخل أكثر من جولة إعادة… بس أنت تصوّت مرة وحدة والنظام يكمل.
                    </p>
                </div>
            </div>
        </div>

        <div id="example" class="mt-14">
            <div class="flex items-end justify-between flex-wrap gap-3">
                <div>
                    <h2 class="text-2xl md:text-3xl font-black text-gray-900">
                        مثال سريع 🔥
                    </h2>
                    <p class="mt-2 text-gray-600">
                        مثال يوضح كيف خيار ضعيف ينحذف… ثم الأصوات تنتقل.
                    </p>
                </div>

                <div class="text-xs font-semibold text-gray-500">
                    <i class="fa-solid fa-flask me-1"></i>
                    محاكاة تعليمية
                </div>
            </div>

            <div class="mt-6 grid lg:grid-cols-3 gap-5">

                <div class="bg-white border border-gray-100 rounded-3xl shadow-sm p-6">
                    <div class="flex items-center justify-between">
                        <div class="font-black text-gray-900">الجولة 1</div>
                        <span class="text-xs px-3 py-1 rounded-full bg-purple-50 border border-purple-100 text-purple-700 font-bold">
                            ما فيه فائز
                        </span>
                    </div>

                    <div class="mt-4 space-y-3 text-sm">
                        <div class="flex justify-between">
                            <span class="font-semibold">🍕 بيتزا</span>
                            <span class="font-extrabold">8</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-semibold">🍔 برجر</span>
                            <span class="font-extrabold">6</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-semibold">🌯 شاورما</span>
                            <span class="font-extrabold">4</span>
                        </div>
                        <div class="flex justify-between text-red-600">
                            <span class="font-semibold">🍣 سوشي</span>
                            <span class="font-extrabold">2</span>
                        </div>
                    </div>

                    <div class="mt-5 rounded-2xl bg-red-50 border border-red-100 p-4 text-sm">
                        <div class="font-extrabold text-red-700 flex items-center gap-2">
                            <i class="fa-solid fa-circle-xmark"></i>
                            المحذوف: 🍣 سوشي
                        </div>
                        <p class="mt-1 text-red-700">
                            لأنه أقل خيار أصوات.
                        </p>
                    </div>
                </div>

                <div class="bg-white border border-gray-100 rounded-3xl shadow-sm p-6">
                    <div class="flex items-center justify-between">
                        <div class="font-black text-gray-900">الجولة 2</div>
                        <span class="text-xs px-3 py-1 rounded-full bg-purple-50 border border-purple-100 text-purple-700 font-bold">
                            نقل أصوات
                        </span>
                    </div>

                    <div class="mt-4 space-y-3 text-sm">
                        <div class="flex justify-between">
                            <span class="font-semibold">🍕 بيتزا</span>
                            <span class="font-extrabold">9</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-semibold">🍔 برجر</span>
                            <span class="font-extrabold">7</span>
                        </div>
                        <div class="flex justify-between text-red-600">
                            <span class="font-semibold">🌯 شاورما</span>
                            <span class="font-extrabold">4</span>
                        </div>
                    </div>

                    <div class="mt-5 rounded-2xl bg-purple-50 border border-purple-100 p-4 text-sm">
                        <div class="font-extrabold text-purple-700 flex items-center gap-2">
                            <i class="fa-solid fa-arrows-rotate"></i>
                            انتقال الأصوات
                        </div>
                        <p class="mt-1 text-purple-700">
                            أصوات 🍣 سوشي راحت للخيار التالي عند أصحابها.
                        </p>
                    </div>

                    <div class="mt-4 rounded-2xl bg-red-50 border border-red-100 p-4 text-sm">
                        <div class="font-extrabold text-red-700 flex items-center gap-2">
                            <i class="fa-solid fa-circle-xmark"></i>
                            المحذوف: 🌯 شاورما
                        </div>
                    </div>
                </div>

                <div class="bg-white border border-gray-100 rounded-3xl shadow-sm p-6">
                    <div class="flex items-center justify-between">
                        <div class="font-black text-gray-900">الجولة 3</div>
                        <span class="text-xs px-3 py-1 rounded-full bg-green-50 border border-green-100 text-green-700 font-bold">
                            فائز 🏆
                        </span>
                    </div>

                    <div class="mt-4 space-y-3 text-sm">
                        <div class="flex justify-between text-green-700">
                            <span class="font-semibold">🍕 بيتزا</span>
                            <span class="font-extrabold">11</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-semibold">🍔 برجر</span>
                            <span class="font-extrabold">9</span>
                        </div>
                    </div>

                    <div class="mt-5 rounded-2xl bg-green-50 border border-green-100 p-4 text-sm">
                        <div class="font-extrabold text-green-700 flex items-center gap-2">
                            <i class="fa-solid fa-trophy"></i>
                            الفائز: 🍕 بيتزا
                        </div>
                        <p class="mt-1 text-green-700">
                            وصل للأغلبية بعد نقل الأصوات.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div id="faq" class="mt-16">
            <h2 class="text-2xl md:text-3xl font-black text-gray-900">
                أسئلة شائعة
            </h2>
            <p class="mt-2 text-gray-600 max-w-2xl">
                أسئلة تتكرر كثير بخصوص نظام RCV 👇
            </p>

            <div class="mt-7 grid md:grid-cols-2 gap-5">

                <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6">
                    <div class="font-extrabold text-gray-900 flex items-center gap-2">
                        <i class="fa-solid fa-circle-question text-purple-600"></i>
                        هل لازم أرتّب كل الخيارات؟
                    </div>
                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                        لا. تقدر ترتّب خيار واحد أو أكثر.
                        بس ترتيب أكثر يفيدك لأن صوتك ممكن ينتقل للخيار اللي بعده.
                    </p>
                </div>

                <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6">
                    <div class="font-extrabold text-gray-900 flex items-center gap-2">
                        <i class="fa-solid fa-circle-question text-purple-600"></i>
                        متى يوقف التصويت؟
                    </div>
                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                        التصويت يوقف تلقائيًا بعد انتهاء المدة اللي حددها صاحب التصويت.
                        بعدها يتم حساب النتيجة ويظهر الفائز.
                    </p>
                </div>

                <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6">
                    <div class="font-extrabold text-gray-900 flex items-center gap-2">
                        <i class="fa-solid fa-circle-question text-purple-600"></i>
                        إذا انحذف خياري الأول… راح؟
                    </div>
                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                        لا! هذا أجمل شي 😄
                        صوتك يتحول تلقائيًا للخيار الثاني اللي أنت رتّبته.
                    </p>
                </div>

                <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6">
                    <div class="font-extrabold text-gray-900 flex items-center gap-2">
                        <i class="fa-solid fa-circle-question text-purple-600"></i>
                        وش يصير لو ما رتّبت إلا خيارات انحذفت؟
                    </div>
                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                        وقتها يعتبر صوتك “منتهي” (يعني ما له خيار ثاني ينتقل له).
                        وبكذا ما ينحسب بالجولات المتقدمة.
                    </p>
                </div>

            </div>
        </div>

        <div class="mt-16 bg-gradient-to-l from-purple-600 to-fuchsia-600 rounded-3xl p-8 md:p-10 text-white shadow-sm">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                <div>
                    <h3 class="text-2xl font-black">جاهز/ة تسوي تصويت؟</h3>
                    <p class="mt-2 text-white/90">
                        أنشئ تصويت جديد وشارك الرابط… وخلي VOTISE يحسبها عنكم 😌
                    </p>
                </div>

                <a asp-controller="Votes" asp-action="Create"
                   class="px-7 py-3 rounded-2xl bg-white text-gray-900 font-extrabold hover:bg-gray-100 transition">
                    <i class="fa-solid fa-plus me-1 text-purple-700"></i>
                    إنشاء تصويت
                </a>
            </div>
        </div>

    </div>
</section>
