@model VotingSystem.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "إنشاء حساب";
}

<div class="max-w-md mx-auto py-24">

    <div class="text-center space-y-3 mb-14">
        <h2 class="text-2xl font-semibold text-gray-700">
            أنشئ حسابك
        </h2>

        <p class="text-gray-500">
            وابدأ التصويت خلال ثواني
        </p>
    </div>

    <form asp-controller="Account" asp-action="Register" method="post" class="space-y-10">

        <div class="space-y-6">

            <div>
                <input
                    asp-for="FullName"
                    type="text"
                    placeholder="الاسم الكامل"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3
                           focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
                <span asp-validation-for="FullName" class="text-red-500 text-xs"></span>

            </div>

            <div>
                <input
                    asp-for="Email"
                    type="email"
                    placeholder="البريد الإلكتروني"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3
                           focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
                <span asp-validation-for="Email" class="text-red-500 text-xs"></span>

            </div>

            <div>
                <input
                    asp-for="Password"
                    type="password"
                    placeholder="كلمة المرور"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3
                           focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
                <span asp-validation-for="Password" class="text-red-500 text-xs"></span>

            </div>

            <div>
                <input
                    asp-for="ConfirmPassword"
                    type="password"
                    placeholder="تأكيد كلمة المرور"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3
                           focus:outline-none focus:ring-2 focus:ring-purple-500"
                />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>

            </div>

        </div>

        <div class="space-y-6">

            <label class="flex items-start gap-3 text-sm text-gray-600">
                <input asp-for="AcceptTerms"
                       type="checkbox"
                       class="mt-1 h-4 w-4 rounded-none accent-purple-600" />

                <span>
                    أوافق على
                    <a href="#" class="text-purple-600 hover:underline font-medium">الشروط</a>
                    و
                    <a href="#" class="text-purple-600 hover:underline font-medium">سياسة الخصوصية</a>
                </span>
            </label>
            
            <span asp-validation-for="AcceptTerms"
                  class="text-red-500 text-xs"></span>


            <div asp-validation-summary="ModelOnly"
                 class="text-red-500 text-sm text-center">
            </div>


            <button
                type="submit"
                class="w-full bg-purple-600 text-white py-3 rounded-xl
                       hover:bg-purple-700 transition"
            >
                إنشاء الحساب
            </button>

        </div>

    </form>

</div>
