@{
    ViewData["Title"] = "الرئيسية";
}

<section class="relative overflow-hidden text-center py-20 px-6">

    <div class="absolute inset-0 -z-10">
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[900px] h-[900px] bg-purple-200/40 blur-3xl rounded-full"></div>
        <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-fuchsia-200/30 blur-3xl rounded-full"></div>
    </div>
    
    <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 border border-purple-100 text-purple-700 rounded-full text-sm shadow-sm">
        <i class="fa-solid fa-shield-heart"></i>
        صوتك ما يضيع
    </span>

    <h1 class="text-4xl md:text-5xl font-extrabold mt-6 text-gray-900 leading-tight">
        رتّب خياراتك…
        <span class="text-transparent bg-clip-text bg-gradient-to-l from-purple-600 to-fuchsia-600">
            والنتيجة تحسمها
        </span>
    </h1>

    
    <p class="text-gray-600 mt-5 max-w-2xl mx-auto text-lg leading-relaxed">
        منصة تصويت إلكترونية مخصصة للقرارات اليومية داخل القروبات والتجمعات
        <br />
        التصويت حسب الترتيب التفضيلي (RCV) هو أسلوب تصويت يسمح للمشارك بترتيب الخيارات حسب الأفضلية
        (الأول، الثاني، الثالث…) بدل اختيار خيار واحد فقط، مما يساعد على الوصول لنتيجة أدق وأكثر تمثيلًا
        لتفضيلات المشاركين.
    </p>



    <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
        <a asp-controller="Votes" asp-action="Create"
           class="bg-purple-600 text-white px-7 py-3 rounded-xl hover:bg-purple-700 shadow-md transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-circle-plus"></i>
            إنشاء تصويت
        </a>

        <a asp-controller="Votes" asp-action="Index"
           class="bg-white px-7 py-3 rounded-xl border hover:bg-gray-50 shadow-sm transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-list-check"></i>
            تصفح التصويتات
        </a>
    </div>
    
</section>

<section class="relative py-20">

    <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

            <div class="text-right">
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 text-purple-700 border border-purple-100 text-sm shadow-sm">
                    <i class="fa-solid fa-share-nodes"></i>
                    شاركها مع القروب
                </span>

                <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-6 leading-snug">
                    خلوها
                    <span class="text-transparent bg-clip-text bg-gradient-to-l from-purple-600 to-fuchsia-600">
                        نتيجة
                    </span>
                    … مو نقاش
                </h2>

                <p class="text-gray-600 mt-5 text-lg leading-relaxed max-w-xl">
                    أنشئ تصويت وشارك الرابط، وكل شخص يرتّب اختياراته بهدوء.
                    بعدها تطلع النتيجة بشكل واضح وتختصر وقت القروب.
                </p>

                <div class="mt-8 flex flex-col sm:flex-row gap-4">
                    <a asp-controller="Votes" asp-action="Create"
                       class="bg-purple-600 text-white px-7 py-3 rounded-xl hover:bg-purple-700 shadow-md transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i>
                        أنشئ تصويت وشاركه
                    </a>

                    <a asp-controller="Votes" asp-action="Index"
                       class="bg-white px-7 py-3 rounded-xl border hover:bg-gray-50 shadow-sm transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-list-check text-purple-600"></i>
                        تصفح التصويتات
                    </a>
                </div>
            </div>

            <!-- Visual -->
            <div class="bg-white/70 backdrop-blur border border-purple-100 rounded-3xl p-8 md:p-10 text-right shadow-sm">
                <p class="text-sm text-gray-500 flex items-center gap-2">
                    <i class="fa-solid fa-lightbulb text-purple-600"></i>
                    أفكار سريعة للتصويت
                </p>

                <div class="mt-6 space-y-4">
                    <div class="bg-white border rounded-2xl px-5 py-4 flex items-center justify-between">
                        <span class="flex items-center gap-3 text-gray-800">
                            <i class="fa-solid fa-utensils text-purple-600"></i>
                            وش نطلب للعشاء؟
                        </span>
                    </div>

                    <div class="bg-white border rounded-2xl px-5 py-4 flex items-center justify-between">
                        <span class="flex items-center gap-3 text-gray-800">
                            <i class="fa-solid fa-location-dot text-purple-600"></i>
                            وين نطلع اليوم؟
                        </span>
                    </div>

                    <div class="bg-white border rounded-2xl px-5 py-4 flex items-center justify-between">
                        <span class="flex items-center gap-3 text-gray-800">
                            <i class="fa-solid fa-gamepad text-purple-600"></i>
                            أي لعبة نلعب؟
                        </span>
                    </div>
                </div>

                <div class="mt-8 grid grid-cols-2 gap-4 text-sm text-gray-700">
                    <div class="bg-white/80 border rounded-2xl px-4 py-3 flex items-center gap-2">
                        <i class="fa-solid fa-link text-purple-600"></i>
                        رابط مباشر
                    </div>
                    <div class="bg-white/80 border rounded-2xl px-4 py-3 flex items-center gap-2">
                        <i class="fa-solid fa-chart-column text-purple-600"></i>
                        نتيجة واضحة
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


<section class="max-w-6xl mx-auto px-6 py-12">
    <div class="w-full text-center border-t border-b border-gray-200 py-12">

        <div class="mx-auto w-14 h-14 rounded-2xl bg-purple-50 border border-purple-100 
                    flex items-center justify-center">
            <i class="fa-solid fa-scale-balanced text-purple-700 text-xl"></i>
        </div>

        <h3 class="mt-5 text-2xl md:text-3xl font-extrabold text-gray-900">
            قوانين احتساب النتائج (RCV)
        </h3>
        <p class="mt-3 text-gray-600 text-lg max-w-none mx-auto whitespace-nowrap overflow-hidden text-ellipsis">
            تعرّف على كيفية احتساب الفائز، مع شرح للجولات والاستبعاد وكيفية انتقال الأصوات تلقائيًا حسب الترتيب.
        </p>


        <div class="mt-7">
            <a asp-controller="Home" asp-action="Rules"
               class="inline-flex items-center gap-2 px-7 py-3 rounded-2xl
                      border border-gray-200 bg-white hover:bg-gray-50 transition">
                <i class="fa-solid fa-file-lines text-purple-700"></i>
                قراءة التفاصيل
            </a>
        </div>
    </div>
</section>
