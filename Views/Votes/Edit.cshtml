@model VotingSystem.Models.Vote
@{
    ViewData["Title"] = "تعديل التصويت";

}

<div class="max-w-3xl mx-auto px-6 py-10">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">

        <h1 class="text-xl font-semibold text-gray-900 flex items-center gap-2 mb-6">
            <i class="fa-regular fa-pen-to-square text-purple-600"></i>
            تعديل التصويت
        </h1>

        <form asp-action="Edit" asp-route-id="@Model.VoteId" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="text-sm text-gray-600">السؤال</label>
                <input asp-for="Title"
                       class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-purple-500" />
            </div>

            <div>
                <label class="text-sm text-gray-600">الوصف</label>
                <textarea asp-for="Description" rows="3"
                          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-purple-500"></textarea>
            </div>

            <div>
                <label class="text-sm text-gray-600">وقت الانتهاء</label>
                <input asp-for="EndTime" type="datetime-local"
                       value="@Model.EndTime.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")"
                       class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-purple-500" />
            </div>

            <input type="hidden" asp-for="VoteId" />
            <input type="hidden" asp-for="StartTime" />
            <input type="hidden" asp-for="Status" />

            <div class="flex gap-2 pt-2">
                <button type="submit"
                        class="px-5 py-3 rounded-xl bg-purple-600 text-white text-sm font-medium hover:bg-purple-700 transition">
                    حفظ
                </button>

                <a asp-action="Manage" asp-route-id="@Model.VoteId"
                   class="px-5 py-3 rounded-xl border border-gray-200 text-sm font-medium hover:bg-gray-50 transition">
                    إلغاء
                </a>
            </div>
            
            
        </form>

        <p class="mt-6 text-[11px] text-gray-500 leading-relaxed">
            <i class="fa-solid fa-circle-info me-1 text-gray-400"></i>
            تعديل الخيارات غير مفعّل هنا (لتجنب تضارب النتائج).
        </p>

    </div>
</div>
