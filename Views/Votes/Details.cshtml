@model VotingSystem.Models.Vote

@{
    ViewData["Title"] = "لوحة التصويت";
    var shareUrl = Url.Action("Rank", "Votes", new { id = Model.VoteId }, protocol: Context.Request.Scheme);

    var now = DateTime.UtcNow;
    var isOpen = Model.Status == VoteStatus.Open && Model.StartTime <= now && Model.EndTime > now;
    var timeLeft = Model.EndTime - now;
    var hasTimeLeft = timeLeft.TotalSeconds > 0;
}

<div class="max-w-6xl mx-auto py-10 px-6 space-y-8">

    <section class="flex items-start justify-between gap-6">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900 flex items-center gap-2">
                <i class="fa-solid fa-chart-simple text-purple-600"></i>
                لوحة التصويت
            </h1>
            <p class="text-sm text-gray-500 mt-1">
                هنا تقدر تدير التصويت، تشاركه، وتتابع التفاعل.
            </p>
        </div>

        <div class="flex items-centergap-3">
            @if (isOpen)
            {
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs bg-green-50 text-green-700 border border-green-100">
                    <span class="w-2 h-2 rounded-full bg-green-500"></span>
                    مفتوح الآن
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs bg-gray-100 text-gray-700 border border-gray-200">
                    <i class="fa-solid fa-lock text-gray-500"></i>
                    مغلق
                </span>
            }

            @if (isOpen && hasTimeLeft)
            {
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs bg-purple-50 text-purple-700 border border-purple-100">
                    <i class="fa-regular fa-clock"></i>
                    <span id="TimeLeft"></span>
                </span>
            }
        </div>
    </section>

    <section class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
        <div class="flex items-center justify-between gap-4 mb-3">
            <h2 class="text-sm font-semibold text-gray-800 flex items-center gap-2">
                <i class="fa-solid fa-share-nodes text-gray-400"></i>
                شارك التصويت
            </h2>
            <span class="text-xs text-gray-400">أرسل الرابط للمشاركين ليبدؤون مباشرة</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 items-center">

            <div class="lg:col-span-7">
                <input id="ShareLink"
                       readonly
                       value="@shareUrl"
                       class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-gray-50 focus:outline-none" />
            </div>

            <div class="lg:col-span-5 flex gap-2">
                <button type="button" id="CopyBtn"
                        class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl
                               text-sm font-medium border border-gray-200 hover:bg-gray-50 transition">
                    <i class="fa-regular fa-copy"></i>
                    Copy
                </button>

                <a href="@shareUrl"
                   class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl
                          text-sm font-medium bg-purple-600 text-white hover:bg-purple-700 transition">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    فتح صفحة التصويت
                </a>
            </div>
        </div>

        <div id="CopyToast"
             class="hidden mt-3 text-xs text-green-700 bg-green-50 border border-green-100 rounded-xl px-4 py-3">
            <i class="fa-solid fa-check me-1"></i>
            تم نسخ الرابط
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-5">
            <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <div class="text-[11px] text-gray-500 mb-1">المشاركين</div>
                <div class="text-sm font-semibold text-gray-900">@Model.Ballots?.Count()</div>
            </div>
            <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <div class="text-[11px] text-gray-500 mb-1">الخيارات</div>
                <div class="text-sm font-semibold text-gray-900">@Model.Options?.Count()</div>
            </div>
            <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <div class="text-[11px] text-gray-500 mb-1">البدء</div>
                <div class="text-sm font-semibold text-gray-900">@Model.StartTime.ToLocalTime().ToString("hh:mm tt")</div>
            </div>
            <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                <div class="text-[11px] text-gray-500 mb-1">الانتهاء</div>
                <div class="text-sm font-semibold text-gray-900">@Model.EndTime.ToLocalTime().ToString("hh:mm tt")</div>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <div class="lg:col-span-7 space-y-6">

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                <h3 class="text-sm font-semibold text-gray-800 flex items-center gap-2 mb-3">
                    <i class="fa-regular fa-circle-question text-gray-400"></i>
                    السؤال
                </h3>

                <div class="text-base font-semibold text-gray-900 leading-relaxed">
                    @Model.Title
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                <h3 class="text-sm font-semibold text-gray-800 flex items-center gap-2 mb-3">
                    <i class="fa-solid fa-list-ul text-gray-400"></i>
                    الخيارات
                </h3>

                <div class="space-y-3">
                    @foreach (var opt in Model.Options)
                    {
                        <div class="flex items-center justify-between gap-4 p-4 rounded-xl border border-gray-100 bg-gray-50 hover:bg-white transition">
                            <div class="text-sm font-medium text-gray-800">
                                @opt.OptionText
                            </div>

                            @* winner badge (later) *@
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="lg:col-span-5 space-y-6">

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                <h3 class="text-sm font-semibold text-gray-800 flex items-center gap-2 mb-4">
                    <i class="fa-solid fa-screwdriver-wrench text-gray-400"></i>
                    إدارة التصويت
                </h3>

                <div class="space-y-3">
                    @if (isOpen)
                    {
                        <form asp-action="Close" asp-controller="Votes" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.VoteId" />
                            <button type="submit"
                                    class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl
                                           text-sm font-medium border border-gray-200 hover:bg-gray-50 transition">
                                <i class="fa-solid fa-stop text-red-500"></i>
                                إغلاق التصويت
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="ReOpen" asp-controller="Votes" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.VoteId" />
                            <button type="submit"
                                    class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl
                                           text-sm font-medium border border-gray-200 hover:bg-gray-50 transition">
                                <i class="fa-solid fa-play text-green-600"></i>
                                إعادة فتح التصويت
                            </button>
                        </form>
                    }

                    <a href="#"
                       class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl
                              text-sm font-medium border border-gray-200 hover:bg-gray-50 transition opacity-60 cursor-not-allowed">
                        <i class="fa-regular fa-pen-to-square"></i>
                        تعديل التصويت (قريبًا)
                    </a>

                    <form asp-action="Delete" asp-controller="Votes" method="post" onsubmit="return confirmDelete();">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.VoteId" />
                        <button type="submit"
                                class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl
                                       text-sm font-medium bg-red-50 text-red-700 border border-red-100 hover:bg-red-100 transition">
                            <i class="fa-regular fa-trash-can"></i>
                            حذف التصويت
                        </button>
                    </form>
                </div>

                <p class="mt-4 text-[11px] text-gray-500 leading-relaxed">
                    <i class="fa-solid fa-circle-info me-1 text-gray-400"></i>
                    يفضل عدم تعديل الخيارات بعد بدء التصويت لتجنب تضارب النتائج.
                </p>
            </div>
            
        </div>

    </section>

</div>

@section Scripts {
<script>
    const copyBtn = document.getElementById("CopyBtn");
    const shareLink = document.getElementById("ShareLink");
    const toast = document.getElementById("CopyToast");

    function showToast() {
        toast.classList.remove("hidden");
        clearTimeout(window.__copyToastTimer);
        window.__copyToastTimer = setTimeout(() => toast.classList.add("hidden"), 2000);
    }

    copyBtn?.addEventListener("click", async () => {
        try {
            await navigator.clipboard.writeText(shareLink.value);
            showToast();
        } catch {
            shareLink.select();
            document.execCommand("copy");
            showToast();
        }
    });

    const timeLeftEl = document.getElementById("TimeLeft");
    if (timeLeftEl) {
        const end = new Date("@Model.EndTime.ToString("o")");

        function tick() {
            const diff = end - new Date();
            if (diff <= 0) {
                timeLeftEl.textContent = "انتهى";
                return;
            }
            const minutes = Math.floor(diff / 60000);
            const hours = Math.floor(minutes / 60);
            const mins = minutes % 60;

            if (hours <= 0) timeLeftEl.textContent = `باقي ${mins} دقيقة`;
            else timeLeftEl.textContent = `باقي ${hours} ساعة و ${mins} دقيقة`;
        }

        tick();
        setInterval(tick, 15000);
    }

    function confirmDelete() {
        return confirm("هل أنت متأكد؟ الحذف نهائي.");
    }
</script>
}
