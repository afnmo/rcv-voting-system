@model VotingSystem.ViewModels.CreateVoteViewModel

@{
    ViewData["Title"] = "إنشاء تصويت";
}

<div class="max-w-6xl mx-auto py-14 px-6">

    <div class="mb-12">
        <h1 class="text-2xl font-semibold text-gray-900 mb-1 flex items-center gap-2">
            <i class="fa-solid fa-square-poll-vertical text-purple-600"></i>
            إنشاء تصويت جديد
        </h1>
    </div>

    <form id="voteForm" method="post">
        @Html.AntiForgeryToken()


        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">

            <div class="lg:col-span-7 space-y-10">

                <section>
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-sm font-medium text-gray-700 flex items-center gap-2">
                            <i class="fa-regular fa-circle-question text-gray-400"></i>
                            السؤال
                        </h2>
                        <span class="text-xs text-gray-400">إجباري</span>
                    </div>

                    <textarea id="Question" name="Question"
                              rows="4"
                              placeholder="مثال: وش نطلب للعشاء اليوم؟"
                              class="w-full border border-gray-200 rounded-2xl px-5 py-4 text-sm
                                     focus:outline-none focus:ring-2 focus:ring-purple-500
                                     placeholder:text-gray-400 bg-white"></textarea>

                    <div class="mt-2 flex justify-end text-xs text-gray-400">
                        <span id="qCount">0</span>
                    </div>
                </section>

                <section>
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-sm font-medium text-gray-700 flex items-center gap-2">
                            <i class="fa-solid fa-list-ul text-gray-400"></i>
                            الخيارات
                        </h2>
                        <span class="text-xs text-gray-400">حد أدنى: 2</span>
                    </div>

                    <div id="OptionsList" class="space-y-3">


                        <div class="option-row flex items-center gap-3">
                            <span class="text-xs text-gray-400 w-6 text-center">1</span>
                            <input type="text" name="Options"
                                   class="option-input w-full border border-gray-200 rounded-2xl px-4 py-3 text-sm
                                          focus:outline-none focus:ring-2 focus:ring-purple-500"
                                   placeholder="الخيار الأول"/>
                            <button type="button"
                                    class="removeOption hidden text-gray-400 hover:text-red-500 px-2">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <div class="option-row flex items-center gap-3">
                            <span class="text-xs text-gray-400 w-6 text-center">2</span>
                            <input type="text" name="Options"
                                   class="option-input w-full border border-gray-200 rounded-2xl px-4 py-3 text-sm
                                          focus:outline-none focus:ring-2 focus:ring-purple-500"
                                   placeholder="الخيار الثاني"/>
                            <button type="button"
                                    class="removeOption hidden text-gray-400 hover:text-red-500 px-2">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                    </div>

                    <button type="button" id="AddOptionBtn"
                            class="mt-4 text-xs font-medium text-purple-600 hover:underline flex items-center gap-1">
                        <i class="fa-solid fa-plus"></i>
                        إضافة خيار
                    </button>
                </section>

            </div>

            <div class="lg:col-span-5 space-y-8">

                <aside class="bg-white rounded-2xl border border-gray-100 shadow-sm p-7 space-y-6">

                    <h3 class="text-sm font-semibold text-gray-800 flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-gray-400"></i>
                        إعداد سريع
                    </h3>

                    <div class="space-y-2">
                        <label class="text-xs font-semibold text-gray-600">
                            مدة التصويت
                        </label>

                        <select id="DurationSelect"
                                class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm
                   focus:outline-none focus:ring-2 focus:ring-purple-500">
                            <option value="24" selected>24 ساعة (مقترح)</option>
                            <option value="6">6 ساعات</option>
                            <option value="12">12 ساعة</option>
                            <option value="48">يومين</option>
                            <option value="72">3 أيام</option>
                            <option value="168">أسبوع</option>
                            <option value="custom">مدة مخصّصة…</option>
                        </select>

                        <input type="hidden" id="DurationHours" name="DurationHours" value="24" />

                        <div id="CustomDuration" class="hidden mt-3 flex items-center gap-3">
                            <input id="CustomDurationValue"
                                   type="number"
                                   min="1"
                                   placeholder="المدة"
                                   class="flex-1 rounded-xl border border-gray-200 bg-white px-3 py-2.5 text-sm
                      focus:outline-none focus:ring-2 focus:ring-purple-500" />

                            <select id="CustomDurationUnit"
                                    class="w-28 rounded-xl border border-gray-200 bg-white px-3 py-2.5 text-sm
                       focus:outline-none focus:ring-2 focus:ring-purple-500">
                                <option value="hours">ساعة</option>
                                <option value="days">يوم</option>
                            </select>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label asp-for="Visibility" class="text-xs font-semibold text-gray-600">
                            نوع التصويت
                        </label>

                        <select asp-for="Visibility"
                                class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm
                   focus:outline-none focus:ring-2 focus:ring-purple-500">
                            <option value="Public">عام (أي أحد يقدر يشوفه)</option>
                            <option value="Private">خاص (فقط أنت)</option>
                        </select>
                    </div>

                    <button type="button" id="AdvancedToggle"
                            class="w-full text-xs text-gray-600 flex items-center justify-between">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-gear"></i>
                            إعدادات متقدمة
                        </span>
                        <span id="AdvIcon">+</span>
                    </button>

                    <div id="AdvancedPanel" class="hidden space-y-3 pt-2">
                        <input id="MaxParticipants"
                               type="number"
                               min="2"
                               placeholder="عدد المشاركين (اختياري)"
                               class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm
                                      focus:outline-none focus:ring-2 focus:ring-purple-500"/>
                    </div>

                    <div id="InlineError"
                         class="hidden text-xs text-red-600 bg-red-50 border border-red-100 rounded-xl p-3">
                    </div>

                    <button type="submit"
                            class="w-full bg-purple-600 text-white py-3 rounded-xl text-sm font-medium
                                   hover:bg-purple-700 transition">
                        <i class="fa-solid fa-paper-plane me-1"></i>
                        إنشاء التصويت
                    </button>

                    <p class="text-[11px] text-gray-400 text-center">
                        سيتم إنشاء رابط مشاركة مباشر
                    </p>

                </aside>

            </div>
        </div>
    </form>
</div>


@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", () => {

    const q = document.getElementById("Question");
    const qCount = document.getElementById("qCount");
    const optionsList = document.getElementById("OptionsList");
    const addBtn = document.getElementById("AddOptionBtn");
    const inlineError = document.getElementById("InlineError");
    const form = document.getElementById("voteForm");

    const advToggle = document.getElementById("AdvancedToggle");
    const advPanel = document.getElementById("AdvancedPanel");
    const advIcon = document.getElementById("AdvIcon");

    const durationSelect = document.getElementById("DurationSelect");
    const customDuration = document.getElementById("CustomDuration");
    const customValue = document.getElementById("CustomDurationValue");
    const customUnit = document.getElementById("CustomDurationUnit");
    const durationHidden = document.getElementById("DurationHours");

    /* ---------------- Duration logic ---------------- */

    durationSelect.addEventListener("change", () => {
        if (durationSelect.value === "custom") {
            customDuration.classList.remove("hidden");
            durationHidden.value = "";
            customValue.focus();
        } else {
            customDuration.classList.add("hidden");
            durationHidden.value = durationSelect.value;
            customValue.value = "";
        }
    });

    customValue.addEventListener("input", () => {
        let hours = parseInt(customValue.value || 0);
        if (customUnit.value === "days") {
            hours *= 24;
        }
        durationHidden.value = hours > 0 ? hours : "";
    });

    customUnit.addEventListener("change", () => {
        customValue.dispatchEvent(new Event("input"));
    });

    /* ---------------- Options helpers ---------------- */

    function renumberOptions() {
        const rows = optionsList.querySelectorAll(".option-row");
        rows.forEach((row, i) => {
            row.querySelector("span").textContent = i + 1;
            row.querySelector(".removeOption")
               .classList.toggle("hidden", rows.length <= 2);
        });
    }

    function getOptions() {
        return [...optionsList.querySelectorAll(".option-input")]
            .map(o => o.value.trim())
            .filter(Boolean);
    }

    /* ---------------- Question ---------------- */

    q.addEventListener("input", () => {
        qCount.textContent = q.value.length;
        inlineError.classList.add("hidden");
    });

    /* ---------------- Add / Remove options ---------------- */

    addBtn.addEventListener("click", () => {
        const row = document.createElement("div");
        row.className = "option-row flex items-center gap-3";
        row.innerHTML = `
            <span class="text-xs text-gray-400 w-6 text-center">0</span>
            <input type="text"
                   name="Options"
                   class="option-input w-full border border-gray-200 rounded-2xl px-4 py-3 text-sm
                          focus:outline-none focus:ring-2 focus:ring-purple-500"
                   placeholder="خيار إضافي" />
            <button type="button"
                    class="removeOption text-gray-400 hover:text-red-500 px-2">
                <i class="fa-solid fa-xmark"></i>
            </button>
        `;
        optionsList.appendChild(row);
        renumberOptions();
        row.querySelector("input").focus();
    });

    optionsList.addEventListener("click", (e) => {
        if (e.target.closest(".removeOption")) {
            e.target.closest(".option-row").remove();
            renumberOptions();
        }
    });

    /* ---------------- Advanced toggle ---------------- */

    advToggle.addEventListener("click", () => {
        const hidden = advPanel.classList.toggle("hidden");
        advIcon.textContent = hidden ? "+" : "−";
    });

    /* ---------------- Form validation ---------------- */

    form.addEventListener("submit", (e) => {
        inlineError.classList.add("hidden");

        if (!q.value.trim()) {
            e.preventDefault();
            inlineError.textContent = "اكتب سؤال التصويت أولًا.";
            inlineError.classList.remove("hidden");
            q.focus();
            return;
        }

        if (getOptions().length < 2) {
            e.preventDefault();
            inlineError.textContent = "أضف خيارين على الأقل.";
            inlineError.classList.remove("hidden");
            return;
        }

        if (!durationHidden.value || parseInt(durationHidden.value) <= 0) {
            e.preventDefault();
            inlineError.textContent = "حدد مدة تصويت صحيحة.";
            inlineError.classList.remove("hidden");
            return;
        }
    });

    /* ---------------- Init ---------------- */

    renumberOptions();
});
</script>
}
