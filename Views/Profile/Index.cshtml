@model VotingSystem.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "حسابي";
    var fullName = User.FindFirst("FullName")?.Value ?? "المستخدم";
}


<div class="max-w-5xl mx-auto px-6 py-10">

    <div class="flex items-center gap-4 mb-10">
        <div class="w-11 h-11 rounded-full bg-purple-600
                    flex items-center justify-center text-white">
            <i class="fa-solid fa-user"></i>
        </div>

        <div>
            <h1 class="text-xl font-bold">@fullName</h1>
            <p class="text-sm text-gray-500">لوحة التحكم الشخصية</p>
        </div>
    </div>

    <div class="flex gap-8 border-b mb-8">

        <button id="createdBtn"
                onclick="showTab('created')"
                class="tab-btn tab-active inline-flex items-center gap-2 pb-2 text-sm text-purple-700 border-b-2 border-purple-600 font-medium transition">
            <i class="fa-solid fa-plus"></i>
            أنشأتها
        </button>

        <button id="joinedBtn"
                onclick="showTab('joined')"
                class="tab-btn inline-flex items-center gap-2 pb-2 text-sm text-gray-500 border-b-2 border-transparent transition hover:text-gray-700">
            <i class="fa-solid fa-check"></i>
            شاركت فيها
        </button>

    </div>

    <div id="createdTab" class="space-y-4">

        @if (!Model.CreatedVotes.Any())
        {
            <div class="text-center text-gray-400 py-20 space-y-4">
                <i class="fa-regular fa-folder-open text-3xl"></i>
                <p>لم تقم بإنشاء أي تصويت بعد</p>

                <a asp-controller="Votes" asp-action="Create"
                   class="inline-flex items-center gap-2
                          px-4 py-1.5 text-sm
                          border border-purple-200 text-purple-700
                          rounded-lg hover:bg-purple-50 transition">
                    <i class="fa-solid fa-plus"></i>
                    إنشاء تصويت جديد
                </a>
            </div>
        }
        else
        {
            @foreach (var vote in Model.CreatedVotes)
            {
                <div class="p-4 border rounded-xl bg-white
                            flex justify-between items-center">

                    <div>
                        <strong class="block">@vote.Title</strong>
                        <span class="text-xs text-gray-500">
                            الحالة:
                            @(vote.Status == VotingSystem.Models.VoteStatus.Open ? "جاري" : "منتهي")
                        </span>
                    </div>

                    <a asp-controller="Votes"
                       asp-action="Results"
                       asp-route-id="@vote.VoteId"
                       class="text-sm text-purple-600 hover:underline">
                        عرض النتائج
                    </a>
                </div>
            }
        }
    </div>

    <div id="joinedTab" class="hidden space-y-4">

        @if (!Model.ParticipatedVotes.Any())
        {
            <div class="text-center text-gray-400 py-20 space-y-4">
                <i class="fa-regular fa-face-smile text-3xl"></i>
                <p>لم تشارك في أي تصويت حتى الآن</p>

                <a asp-controller="Votes" asp-action="Index"
                   class="inline-flex items-center gap-2
                          px-4 py-1.5 text-sm
                          border rounded-lg hover:bg-gray-50 transition">
                    <i class="fa-solid fa-list"></i>
                    استعرض التصويتات
                </a>
            </div>
        }
        else
        {
            @foreach (var vote in Model.ParticipatedVotes)
            {
                <div class="p-4 border rounded-xl bg-white
                            flex justify-between items-center">

                    <strong>@vote.Title</strong>

                    <a asp-controller="Votes"
                       asp-action="Results"
                       asp-route-id="@vote.VoteId"
                       class="text-sm text-purple-600 hover:underline">
                        عرض النتائج
                    </a>
                </div>
            }
        }
    </div>

</div>
<script>
    function showTab(tab) {
        document.getElementById('createdTab').classList.add('hidden');
        document.getElementById('joinedTab').classList.add('hidden');

        document.getElementById(tab + 'Tab').classList.remove('hidden');

        const createdBtn = document.getElementById('createdBtn');
        const joinedBtn = document.getElementById('joinedBtn');

        [createdBtn, joinedBtn].forEach(btn => {
            btn.classList.remove('text-purple-700', 'border-purple-600', 'font-medium');
            btn.classList.add('text-gray-500', 'border-transparent');
        });

        const activeBtn = document.getElementById(tab + 'Btn');
        activeBtn.classList.remove('text-gray-500', 'border-transparent');
        activeBtn.classList.add('text-purple-700', 'border-purple-600', 'font-medium');
    }
</script>
